<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SolidCraftAgent.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SolidCraft Agent">
  <Grid>
    <NavigationView
        x:Name="NavView"
        PaneDisplayMode="Left"
        IsSettingsVisible="False"
        SelectionChanged="NavView_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Session" Tag="Session" Icon="Document" />
        <NavigationViewItem Content="Lessons" Tag="Lessons" Icon="Bookmarks" />
        <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
      </NavigationView.MenuItems>
      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
