<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SolidCraftAgent.App.Views.LessonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Lessons" Style="{StaticResource TitleTextBlockStyle}" />

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
      <ComboBox x:Name="StatusFilter" Width="160" SelectionChanged="StatusFilter_SelectionChanged">
        <ComboBoxItem Content="All" Tag="" IsSelected="True" />
        <ComboBoxItem Content="Seed" Tag="Seed" />
        <ComboBoxItem Content="Pending" Tag="Pending" />
        <ComboBoxItem Content="Approved" Tag="Approved" />
        <ComboBoxItem Content="Folded" Tag="Folded" />
        <ComboBoxItem Content="Rejected" Tag="Rejected" />
      </ComboBox>
      <Button Content="Refresh" Click="Refresh_Click" />
      <Button Content="Approve" Click="Approve_Click" />
      <Button Content="Reject" Click="Reject_Click" />
      <Button Content="Fold selected" Click="Fold_Click" />
    </StackPanel>

    <ListView x:Name="LessonList" Grid.Row="2" SelectionMode="Extended">
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel Spacing="2" Margin="0,4">
            <TextBlock FontWeight="SemiBold">
              <Run Text="{Binding Id}" />
              <Run Text=" - " />
              <Run Text="{Binding Title}" />
            </TextBlock>
            <TextBlock Opacity="0.7" Text="{Binding Status}" />
            <TextBlock TextWrapping="Wrap" MaxLines="4" Text="{Binding Body}" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock x:Name="HintText" Grid.Row="3" Opacity="0.7"
               Text="Approved and seed lessons inject into the system prompt. Fold marks lessons as packaged into the skill pack." />
  </Grid>
</Page>
