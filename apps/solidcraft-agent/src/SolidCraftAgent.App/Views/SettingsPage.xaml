<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SolidCraftAgent.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Padding="16">
    <StackPanel Spacing="12" MaxWidth="720">
      <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

      <TextBlock Text="LLM (matches SolidCraft Add agent)" Style="{StaticResource SubtitleTextBlockStyle}" />
      <TextBox x:Name="AgentNameBox" Header="Name" />
      <ComboBox x:Name="ProviderBox" Width="360" Header="Protocol" SelectionChanged="ProviderBox_SelectionChanged">
        <ComboBoxItem Content="Anthropic-compatible API" Tag="Claude" />
        <ComboBoxItem Content="OpenAI-compatible API (OpenAI cloud)" Tag="OpenAi" />
        <ComboBoxItem Content="OpenAI-compatible API (local: Ollama / LM Studio)" Tag="OpenAiCompatible" />
      </ComboBox>

      <TextBox x:Name="ClaudeBaseBox" Header="Anthropic base URL (e.g. https://api.anthropic.com/v1)" />
      <TextBox x:Name="ClaudeModelBox" Header="Anthropic model id" />
      <PasswordBox x:Name="ClaudeKeyBox" Header="Anthropic API key (optional; Windows Credential Manager)" />

      <TextBox x:Name="OpenAiBaseBox" Header="OpenAI base URL" />
      <TextBox x:Name="OpenAiModelBox" Header="OpenAI model id" />
      <PasswordBox x:Name="OpenAiKeyBox" Header="OpenAI API key" />

      <TextBox x:Name="LocalBaseBox" Header="Local OpenAI-compatible base URL" />
      <TextBox x:Name="LocalModelBox" Header="Local model id" />
      <PasswordBox x:Name="LocalKeyBox" Header="Local API key (optional)" />

      <NumberBox x:Name="TimeoutBox" Header="Request timeout (seconds)" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Inline" />

      <TextBlock TextWrapping="Wrap" Opacity="0.7"
                 Text="API keys are stored in the system keychain (Windows Credential Manager), never in settings.json. Leave the Anthropic key empty for a local Anthropic-compatible server." />

      <TextBlock Text="SolidCraft MCP" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
      <TextBox x:Name="McpCommandBox" Header="MCP command (Cursor default: C:\Program Files\SolidCraft\solidcraft-cli.exe)" />
      <TextBox x:Name="McpArgsBox" Header="MCP arguments (Cursor default: mcp)" />
      <TextBox x:Name="McpCwdBox" Header="MCP working directory (optional)" />
      <TextBlock TextWrapping="Wrap" Opacity="0.7"
                 Text="Matches Cursor mcp.json server SolidCraft: solidcraft-cli.exe with args [mcp]." />

      <TextBlock Text="Models" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
      <TextBox x:Name="UnitsBox" Header="Default units" />
      <TextBox x:Name="ModelsFolderBox" Header="Permanent save folder" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Save settings" Click="Save_Click" />
        <TextBlock x:Name="SaveStatus" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
